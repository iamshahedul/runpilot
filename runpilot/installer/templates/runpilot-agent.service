[Unit]
Description=RunPilot Host Agent Daemon
After=network.target systemd-journald.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/runpilot
ExecStart=/opt/runpilot/bin/runpilot-agent -config /etc/runpilot/agent.json
Restart=always
RestartSec=5s

# File descriptor limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
